{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "investors.evely.health" }],
      "destination": "/investors/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "investors.evely.health" }],
      "destination": "/investors/:path*"
    }
  ]
}
